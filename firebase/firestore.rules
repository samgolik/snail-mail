rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isParticipant(data) {
      return signedIn() && request.auth.uid in data.userIDs;
    }

    match /users/{userID} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userID;
      allow update: if signedIn()
        && request.auth.uid == userID
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'username', 'usernameNormalized', 'city',
          'latitude', 'longitude', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /friendships/{friendshipID} {
      allow read: if isParticipant(resource.data);
      // Friendship mutations go through server functions so clients cannot
      // manufacture accepted relationships.
      allow write: if false;
    }

    match /letters/{letterID} {
      allow read: if signedIn()
        && (request.auth.uid == resource.data.senderID
          || request.auth.uid == resource.data.recipientID);
      // Letter metadata and arrival state are server-owned.
      allow write: if false;
    }

    match /sealedLetters/{letterID} {
      // Bodies are never read directly. openLetter verifies server time and
      // returns the body only to the authenticated recipient.
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
